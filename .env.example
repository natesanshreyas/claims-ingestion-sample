# ======================= Document source (claim files live on the file share) =======================
# local      = folder: <RAW_LOCAL_DIR>/<claim_id>/.../<file>   (the file share mounted or copied locally)
# blob       = container: <RAW_CONTAINER>/<claim_id>/.../<file> (share landed in Blob via AzCopy / File Sync)
# documentum = stub only (see sources/__init__.py)
DOCUMENT_SOURCE=local
RAW_LOCAL_DIR=/mnt/claims-share
RAW_CONTAINER=raw

# ======================= Analyzer =======================
# docintel (MVP) = Document Intelligence layout + chat-completion classify/extract
# cu             = Content Understanding classifier + per-group analyzers (run analyzers/create_cu_analyzers.py first)
ANALYZER_BACKEND=docintel

# Document Intelligence (Foundry / AI Services resource endpoint)
DOCINTEL_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com
# Foundry project: chat completions (Doc Intel path) and the agent
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
CHAT_MODEL_DEPLOYMENT=gpt-4.1
MAX_EXTRACTION_CHARS=100000
MAX_FIGURES_PER_DOCUMENT=10

# Content Understanding (needed only for ANALYZER_BACKEND=cu)
CU_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
CU_API_VERSION=2025-11-01
CU_ANALYZER_PREFIX=claims_
CU_COMPLETION_MODEL=gpt-4.1
IMAGE_HEAVY_MAX_TEXT_CHARS=300

# ======================= Azure Storage =======================
STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
ANALYZED_CONTAINER=analyzed

# ======================= Azure AI Search =======================
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_INDEXER_NAME=claims-analyzed-indexer

# ======================= Databricks (structured claims data, log notes, pipeline status) =======================
DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
# Pick ONE auth method:
# Option A (Azure managed identity, recommended in Azure): add the MI to the workspace first
# DATABRICKS_AUTH_TYPE=azure-msi
# ARM_CLIENT_ID=<user-assigned MI client id; omit for system-assigned>
# Option B (OAuth M2M with a Databricks service principal)
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=          # load from Key Vault / pipeline secret; never commit
# Option C (local dev only): personal access token
# DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=abcdef1234567890
DATABRICKS_STATUS_TABLE=claims.ai.document_ingestion_status
BATCH_SIZE=50

# --- Optional: log notes -> search (log_notes_to_search.py)
DATABRICKS_LOGNOTES_TABLE=claims.silver.claim_log_notes
LOGNOTES_TEXT_COLUMNS=adjuster_note,coverage_note,liability_note,damages_note,medical_note,legal_note,subrogation_note,supervisor_note
LOGNOTES_DATE_COLUMN=note_date
LOGNOTES_CLAIM_IDS=                  # comma-separated pilot claims; empty = all
LOGNOTES_CONTAINER=lognotes
LOGNOTES_INDEXER_NAME=claims-lognotes-indexer

# ======================= Foundry agent (agent/create_agent.py, agent/ask_agent.py) =======================
AGENT_NAME=claims-assistant
AGENT_MODEL_DEPLOYMENT=gpt-4.1
SEARCH_CONNECTION_NAME=<project connection to the AI Search service>
SEARCH_INDEX_NAME=claims-index
SEARCH_QUERY_TYPE=vector_semantic_hybrid   # use "simple" for an index without vectors / semantic config
SEARCH_TOP_K=8
# --- Optional, preview: Databricks Genie tool (create_agent.py --with-databricks)
# DATABRICKS_GENIE_MCP_URL=
# DATABRICKS_GENIE_CONNECTION_NAME=

# ======================= Local dev =======================
# DefaultAzureCredential uses `az login` if nothing else is configured.
# AZURE_CLIENT_ID=<user-assigned MI client id, when running in Azure with a UAMI>
